{
  "name": "@vastermortgage/email",
  "version": "0.1.3",
  "description": "Shared transactional email templates for Vaster applications",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "email dev --dir ./emails --port 3001",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external react --external react-dom --external react-email --production",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build",
    "test": "bun run build && bun test ./test"
  },
  "dependencies": {
    "react-email": "6.9.3"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
